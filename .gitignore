# ===================================================================
# SysAmp v2.91 - .gitignore
# ===================================================================

# ---- Dependencies (reinstalled with npm install) ----
node_modules/
frontend/node_modules/
backend/node_modules/

# ---- Build output (regenerated with npm run build) ----
dist/
build/
frontend/dist/
*.local

# ---- Secrets & environment variables (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.json
credentials.json
config.local.*

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Runtime, cache & coverage ----
.cache/
.parcel-cache/
.vite/
.eslintcache
.npm/
*.tgz
coverage/
.nyc_output/
tmp/
temp/

# ---- Docker local data & overrides ----
docker-compose.override.yml
*.docker-data/
volumes/

# ---- Editor & IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---- OS generated files ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
System Volume Information/
